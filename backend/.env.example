# Shared secret required as a Bearer token on every route except GET /health.
APP_SECRET=change-me

# JSON list of allowed CORS origins for the frontend, e.g. the Vite dev server.
CORS_ORIGINS=["http://localhost:5173"]

# Optional. fal.ai API key used to generate the post-game coaching summary
# via fal.ai's OpenAI-compatible endpoint. If unset, coaching summaries are
# simply skipped (coaching_summary stays null) -- everything else still
# works. Get a key at https://fal.ai/dashboard/keys.
FAL_KEY=change-me
